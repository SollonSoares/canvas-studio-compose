{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Espelhar Tela do Celular (scrcpy)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/mirror_phone.ps1"
            ],
            "problemMatcher": []
        },
        {
            "label": "Conectar Celular (Wi-Fi)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/connect_device.ps1"
            ],
            "problemMatcher": []
        },
        {
            "label": "Compilar e Instalar App (Debug)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/deploy_debug.ps1"
            ],
            "isBackground": true,
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
